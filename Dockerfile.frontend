FROM node:22.23.2-alpine3.23 AS build
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web ./
RUN npm run build

FROM node:22.23.2-alpine3.23
ENV HOST=0.0.0.0 PORT=4321 NODE_ENV=production
WORKDIR /app
COPY --from=build /app ./
USER node
EXPOSE 4321
CMD ["node", "./dist/server/entry.mjs"]
