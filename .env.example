APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://ccarp:change-me@database:5432/ccarp?sslmode=disable
SESSION_SECRET=replace-with-at-least-32-random-characters
MCP_SERVICE_TOKEN_HASH=sha256:replace-with-token-hash
MCP_CONTENT_AUTHOR_ID=replace-with-active-user-uuid
PUBLIC_BASE_URL=http://localhost:4321
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:4321
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace-with-at-least-12-characters
SEED_ADMIN_DISPLAY_NAME=Development Administrator
POSTGRES_DB=ccarp
POSTGRES_USER=ccarp
POSTGRES_PASSWORD=change-me
