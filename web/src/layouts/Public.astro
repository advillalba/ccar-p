---
import { BACKEND_URL } from 'astro:env/server';
import { type BreadcrumbItem, type NavCurrent } from '../lib';
import CookieConsent from '../islands/CookieConsent';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/shell.css';

export type { NavCurrent, BreadcrumbItem };

export interface Props {
  title: string;
  description?: string;
  current?: NavCurrent;
  breadcrumbs?: BreadcrumbItem[];
  extraStylesheets?: string[];
  extraScripts?: string[];
  skipToMain?: boolean;
  // Static site mode (GitHub Pages): hides account/login controls, prefixes
  // internal links with the deployment base path, and skips backend lookups.
  staticMode?: boolean;
}

const { title, description, current = null, breadcrumbs = [], extraStylesheets = [], extraScripts = [], skipToMain = true, staticMode = false } = Astro.props;
const sessionCookie = Astro.request.headers.get('cookie') ?? '';
let user: { display_name: string; role: string } | null = null;
if (!staticMode) {
  try {
    const response = await fetch(`${BACKEND_URL}/api/v1/me`, { headers: sessionCookie ? { cookie: sessionCookie } : {} });
    user = response.ok ? (await response.json())?.data ?? null : null;
  } catch {}
}

// In static mode every internal link is prefixed with the deployment base path
// (PUBLIC_BASE_PATH, e.g. /ccar-p for a GitHub Pages project site).
const publicBase = (import.meta.env as unknown as Record<string, string | undefined>).PUBLIC_BASE_PATH ?? '';
const basePath = staticMode ? `${publicBase}/site` : '';

function aria(value: NavCurrent, expected: NavCurrent): { 'aria-current': 'page' | undefined } {
  return { 'aria-current': value === expected ? 'page' : undefined };
}

const icons: Record<string, string> = {
  notes: '<path d="M4 19.5V5.5A2.5 2.5 0 0 1 6.5 3H20v14.5"/><path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-4.5"/><path d="M8.5 7.5h7M8.5 11h4.5"/>',
  exams: '<rect x="4.5" y="3.5" width="15" height="17.5" rx="2.5"/><path d="M8.5 8.5h7M8.5 12.5h7M8.5 16.5h4"/>',
  practice: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.25"/><path d="M12 12h.01"/>',
  attempts: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3.2 1.9"/>'
};

// Full tab set for SSR; the static edition only ships the practice section.
const allTabs: { href: string; label: string; key: Exclude<NavCurrent, null | 'home'> }[] = [
  { href: '/notes', label: 'Notes', key: 'notes' },
  { href: '/exams', label: 'Exams', key: 'exams' },
  { href: '/practice', label: 'Practice', key: 'practice' },
  { href: '/attempts', label: 'Results', key: 'attempts' }
];
const tabs = staticMode
  ? [{ href: `${basePath}/practice`, label: 'Practice', key: 'practice' as Exclude<NavCurrent, null | 'home'> }]
  : allTabs;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description ?? 'CCAR-P study platform with notes and practice exams.'} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f6f8" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b1220" />
    <link rel="icon" href={staticMode ? `${publicBase}/favicon.svg` : '/favicon.svg'} />
    <title>{title} | CCAR-P Study</title>
    {extraStylesheets.map(href => <link rel="stylesheet" href={href} />)}
    {extraScripts.map(src => <script is:inline src={src} defer></script>)}
  </head>
  <body>
    {skipToMain && <a class="skip-link" href="#main">Skip to main content</a>}
    <header class="app-header">
      <div class="app-header__inner">
        <a class="brand" href={staticMode ? `${basePath}/` : '/'} {...aria(current, 'home')}><span class="brand__dot" aria-hidden="true"></span>CCAR-P</a>
        <nav aria-label="Primary" class="app-header__nav">
          <ul>
            {tabs.map(tab => <li><a href={tab.href} {...aria(current, tab.key)}>{tab.label}</a></li>)}
          </ul>
        </nav>
        {!staticMode && (
          <div class="app-header__account">
            {user ? (
              <>
                <a class="account-id" href="/account" style="text-decoration:none">
                  <span class="account-name">{user.display_name}</span>
                  <span class="account-role">{user.role}</span>
                </a>
                <a class="btn btn--sm btn--ghost" href="/stats">Stats</a>
                <a class="btn btn--sm btn--ghost" href="/account" title="Borrar cuenta">Account</a>
              </>
            ) : (
              <>
                <a class="btn btn--sm btn--primary" href="/login">Sign in</a>
                <a class="btn btn--sm btn--ghost hide-xs" href="/register">Register</a>
              </>
            )}
          </div>
        )}
      </div>
    </header>
    {breadcrumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="breadcrumbs">
        <ol>
          {breadcrumbs.map(crumb => <li>{crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}</li>)}
        </ol>
      </nav>
    )}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="app-footer">
      <p>Independent study material. Verify against authoritative sources.</p>
      {!staticMode && <p><a href="/health">Service status</a></p>}
    </footer>
    <nav class="tabbar" aria-label="Sections">
      {tabs.map(tab => (
        <a class="tabbar__item" href={tab.href} {...aria(current, tab.key)}>
          <span class="tabbar__glyph">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[tab.key]} />
          </span>
          <span>{tab.label}</span>
        </a>
      ))}
    </nav>
    {!staticMode && <script is:inline src="/forms.js" defer></script>}
    <CookieConsent client:load />
  </body>
</html>
