---
export const prerender = false;
import { BACKEND_URL } from 'astro:env/server';
import Public from '../layouts/Public.astro';

let csrfToken = '';
let initError = '';
try {
  const response = await fetch(`${BACKEND_URL}/api/v1/auth/csrf`);
  const envelope = response.ok ? await response.json() : null;
  csrfToken = envelope?.data?.csrf_token ?? '';
  const setCookie = response.headers.get('set-cookie');
  if (setCookie) Astro.response.headers.append('set-cookie', setCookie);
  if (!csrfToken) initError = 'Unable to load the registration form right now.';
} catch {
  initError = 'Unable to load the registration form right now.';
}
---
<Public title="Create account" breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Register' }]}>
  <section class="page" aria-labelledby="register-title">
    <div class="card auth-card">
      <h1 id="register-title">Create your account</h1>
      <p class="page-head__lead">Create an account to save your practice attempts.</p>
      {initError ? (
        <div class="alert alert--error" role="alert"><p>{initError}</p></div>
      ) : (
        <form id="register-form" method="post" action="/api/v1/auth/register" data-json data-success="/login" novalidate>
          <input type="hidden" name="csrf_token" value={csrfToken} />
          <div class="form">
            <div data-form-status role="status" aria-live="polite"></div>
            <div class="field">
              <label for="email">Username or email</label>
              <input id="email" name="email" type="text" autocomplete="username" required spellcheck="false" />
            </div>
            <div class="field">
              <label for="display_name">Display name</label>
              <input id="display_name" name="display_name" autocomplete="name" maxlength="100" required aria-describedby="display-help" />
              <span id="display-help" class="field__hint">Shown with your study activity.</span>
            </div>
            <div class="field">
              <label for="password">Password</label>
              <input id="password" name="password" type="password" autocomplete="new-password" minlength="4" required aria-describedby="password-help" />
              <span id="password-help" class="field__hint">Use at least 4 characters.</span>
            </div>
            <button type="submit" class="btn btn--primary btn--block">Create account</button>
            <noscript><p class="noscript-note">Registration uses the standard server form. If your browser shows JSON after submission, return to <a href="/login">sign in</a>.</p></noscript>
          </div>
        </form>
      )}
      <p>Already registered? <a href="/login">Sign in.</a></p>
    </div>
  </section>
</Public>
<style>
  .auth-card {
    width: 100%;
    max-width: 24rem;
    margin-inline: auto;
    display: grid;
    gap: 1.1rem;
  }
</style>
